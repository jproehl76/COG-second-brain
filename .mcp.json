{
  "mcpServers": {
    "mnemoverse": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mnemoverse/mcp-memory-server@latest"
      ],
      "env": {
        "MNEMOVERSE_API_KEY": "${MNEMOVERSE_API_KEY}"
      }
    },
    "apify": {
      "type": "http",
      "url": "https://mcp.apify.com"
    }
  }
}